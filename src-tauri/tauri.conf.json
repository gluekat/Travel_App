{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PackWise",
  "version": "0.1.0",
  "identifier": "app.packwise.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PackWise",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://geocoding-api.open-meteo.com https://api.open-meteo.com https://archive-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Plan and pack outfits for your trips. Your data stays on your computer.",
    "category": "Travel"
  }
}
