{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PackWise: core APIs plus read/write of its own data file only (Documents/PackWise, or app data on mobile).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/PackWise"
        },
        {
          "path": "$DOCUMENT/PackWise/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}
